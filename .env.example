# Copy to .env and adjust. Every value here has a working default in compose.yaml;
# this file exists to show what is tunable without reading the compose file.

# Where llama.cpp keeps downloaded GGUF weights. Point several checkouts at one
# directory rather than downloading the same model twice.
MODEL_CACHE=./cache

# The language model, and the alias the pipeline must address it by.
# Keep LLM_ALIAS matching the pipeline's --model_name.
LLM_GGUF=ggml-org/gemma-4-E4B-it-GGUF:Q4_0
LLM_ALIAS=local-gemma
LLM_CONTEXT=16384

# One llama.cpp slot per pipeline unit, so a full pool never queues on the LLM.
LLM_PARALLEL=4

# GPU for llama.cpp. The speech pipeline defaults to the other card.
LLM_GPU=0

# The tap writes its JSONL trace to a bind-mounted host directory, so it must run
# as a uid that owns ./progress/logs. Set this if yours is not 1000:1000.
#   DOCKER_USER=$(id -u):$(id -g)
DOCKER_USER=1000:1000

# Ports. Defaults avoid 8080, 8765 and 3000, which are the first ports anything
# else on a shared workstation takes.
LLAMA_PORT=18080
TAP_PORT=18900
EXPORTER_PORT=18901
PIPELINE_PORT=18765
PROMETHEUS_PORT=19090
GRAFANA_PORT=13000
WEB_PORT=18088
